@page
@model Chit_Daria_Miruna_Lab2.Pages.Publishers.CreateModel

@{
    ViewData["Title"] = "Create Publisher";
}

<h1>Create Publisher</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div class="form-group mb-3">
                <label asp-for="Publisher.PublisherName" class="control-label"></label>
                <input asp-for="Publisher.PublisherName" class="form-control" />
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-page="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>